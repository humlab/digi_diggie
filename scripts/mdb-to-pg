#!/bin/bash
# dumps a MS Access .mdb database into a PostgreSQL database
# requires mdbtools and psql client installed

SHELL=/bin/bash

INFO='\033[38;5;208m'
SUCCESS='\033[38;5;82m'
WARNING='\033[38;5;220m'
ERROR='\033[38;5;196m'
NC='\033[0m'

set -e
# set -o pipefail
# IFS=$'\n\t'

if [ -f "$(dirname $0)/docker/.env" ]; then
    set -o allexport
    export $(grep -v 'PASSWORD' "$(dirname $0)/docker/.env" | xargs)
    set +o allexport
fi

KNOWN_TABLES=( "parishes" "communities" "sources" "land_use" "legal_sources" "winners" "seasons" "judgements" "persons" "entries" )

g_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
g_database=${POSTGRES_DB:-digidiggie}
g_schema=public # FIXME: #23 schema is currently hardcoded to `digidiggie_tog` in the SQL files, but should be made configurable
g_command=
g_skip_schema=NO
g_skip_data=NO
g_skip_comments=NO
g_host=localhost
g_user=${POSTGRES_USER:-gudrun}
g_port=${POSTGRES_PORT:-5433}
g_timestamp=$(date +'%Y%m%d_%H%M%S')
g_data_sql_file="./resources/data.sql"
g_schema_file="./resources/schema.sql"
g_input_file=

g_pgpassfile=${g_script_dir}/../.pgpass

usage() {
    local exit_code=0
    if [ "$1" != "" ]; then
        echo "error: $1" >&2
        exit_code=64
    fi
  cat <<EOF
Usage: $(basename "$0") [dump|load] [--database NAME] [--schema NAME] [--host HOST] [--user USER] [--port PORT] <input_file.mdb>

Options:
  --database,          Target database name (default: \$POSTGRES_DB or required)
  --schema,            Target schema name (default: ${g_schema})
  --skip-schema,       Skip dump/load schema (default: false)
  --skip-data,         Skip dump/load data (default: false)
  --skip-comments,     Skip dump/load comments (default: false)
  --sql-data-file,     Output data SQL file (default: ./data.sql)
  --sql-schema-file,   Output schema SQL file (default: ./schema.sql)
  --host,              PostgreSQL host (default: ${g_host})
  --user,              PostgreSQL user (default: ${g_user})
  --port,              PostgreSQL port (default: 5433)
  --help               Show this help

Auth:
  Use a .pgpass entry or export PGPASSWORD; script does NOT prompt.
EOF

    exit ${exit_code}
}

# ----- subcommand -----
g_command="${1:-}"
if [[ -z "$g_command" || "$g_command" == "--help" ]]; then
  usage; exit 0
fi

if [[ "$g_command" != "load" && "$g_command" != "dump" ]]; then
  usage "first arg must be 'dump' or 'load' (got '$g_command')."
  exit 2
fi
shift  # consume subcommand

# ----- options -----
while [[ $# -gt 0 ]]; do
  case "$1" in
    --database)        g_database="$2"; shift 2 ;;
    --schema)          g_schema="$2"; shift 2 ;;
    --sql-data-file)   g_data_sql_file="$2"; shift 2 ;;
    --sql-schema-file) g_schema_file="$2"; shift 2 ;;
    --skip-schema)     g_skip_schema="YES"; shift ;;
    --skip-comments)   g_skip_comments="YES"; shift ;;
    --skip-data)       g_skip_data="YES"; shift ;;
    --host)            g_host="$2"; shift 2 ;;
    --user)            g_user="$2"; shift 2 ;;
    --port)            g_port="$2"; shift 2 ;;
    --help)            usage; exit 0 ;;
    --)                shift; break ;;   # stop option parsing
    -*)                echo "Unknown option: $1" >&2; usage; exit 2 ;;
    *)                 break ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage "missing INPUTFILE."
  exit 2
fi
g_input_file="$1"
shift

if [[ $# -gt 0 ]]; then
  echo "Unexpected extra arguments: $*" >&2
  usage; exit 2
fi

function dump_schema() {

    local input_file=$1
    local output_file=$2

    mdb-schema --not-null --default-values \
        --namespace="${g_schema}" \
        --drop-table \
        --not-null \
        --default-values \
        --comments \
        --indexes \
        --relations \
        "$input_file" postgres > "$output_file"

    echo -e "${SUCCESS}success: schema dumped to $output_file${NC}"
}

g_dump_format="sql"

function dump_data() {
    local input_file=$1
    local output_file=$2

    local tables=$(mdb-tables "$input_file")

    if [ "$g_dump_format" == "sql" ]; then
        echo "BEGIN;" > "$output_file"
        for table in "${KNOWN_TABLES[@]}"; do
            mdb-export --boolean-words --namespace="$g_schema" --insert=postgres "$input_file" "$table" >> "$output_file"
        done
        echo "COMMIT;" >> "$output_file"
    elif [ "$g_dump_format" == "csv" ]; then
        for table in $tables; do
            mdb-export --no-header "$input_file" "$table" > "${table}.csv"
        done
    else
        echo -e "${ERROR}error: only sql dump format is supported${NC}" >&2
        exit 1
    fi

    echo -e "${SUCCESS}success: data dumped to $output_file${NC}"

}

function execute_sql() {
    local sql=$1
    PGPASSFILE="${g_pgpassfile}" psql -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -tac "$sql"
}


function execute_sql_file() {
    local sql=$1
    PGPASSFILE="${g_pgpassfile}" psql --no-password -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -f "$sql"
}

function drop_data() {
    local input_file=$1
    for table in $(mdb-tables "$input_file"); do
        table="${table,,}"
        execute_sql "drop table if exists \"$table\" cascade;" >& /dev/null
        echo -e "${INFO}info: dropped table $table${NC}"
    done
}

function format_sql_file() {
    if command -v pg_format >/dev/null 2>&1; then
        local sql_file=$1
        pg_format -i  "$sql_file"
    fi
}

function check_requirements() {
  for c in mdb-schema mdb-tables mdb-export psql; do
    command -v "$c" >/dev/null 2>&1 || { echo -e "${ERROR}error: missing $c${NC}" >&2; exit 1; }
  done
  for d in "$g_host" "$g_user" "$g_port" "$g_database"; do
    [ -n "$d" ] || { echo -e "${ERROR}error: missing database connection parameter${NC}" >&2; exit 1; }
  done
  [ "$g_input_file" != "" ] || { usage "error: input file not specified" >&2;  }
  [ -f "$g_input_file" ] || { usage "error: input file $g_input_file not found" >&2;  }
}

function load_data() {
    local sql_file=$1

    
    echo -e "${INFO}info: loading data from $sql_file ...${NC}"
    execute_sql_file "$sql_file"
    echo -e "${INFO}info: loading post-load SQL ...${NC}"
    execute_sql_file "resources/post-load.sql"
    echo -e "${SUCCESS}success: data imported successfully into $g_database${NC}"
}

function load_schema() {
    local sql_file=$1
    echo -e "${INFO}info: loading pre-load SQL ...${NC}"
    execute_sql_file "resources/pre-load.sql"
    echo -e "${INFO}info: loading schema from $sql_file ...${NC}"
    execute_sql_file "$sql_file"
    echo -e "${SUCCESS}success: schema imported successfully into $g_database${NC}"
}

function extract_comments() {
    db="${1:?usage: $0 path/to.db.accdb}"
    out="${2:-descriptions.sql}"
    > "$out"
    mdb-tables -1 "$db" |
    while IFS= read -r t; do
    mdb-prop "$db" "$t" |
        awk -v tbl="$t" -v schema="$g_schema" '
    function dq_ident(s) { gsub(/"/,"""",s); return "\"" s "\"" }   # " -> ""
    function esc_sql(s)  {
      gsub(/\r/," ",s); gsub(/\t/," ",s);                         # keep it one line
      gsub(/'\''/,"'\'''\''",s);                                   # '\'' -> '' (double single-quotes)
      return s
    }

    /^[[:space:]]*name:/ {
      f=$0; sub(/^[[:space:]]*name:[[:space:]]*/,"",f); next
    }

    /^[[:space:]]*Description:/ && f!="" && f!="(none)" {
      d=$0; sub(/^[[:space:]]*Description:[[:space:]]*/,"",d);
      if (d != "") {
        printf "COMMENT ON COLUMN %s.%s.%s IS '\''%s'\'';\n",
               dq_ident(schema), dq_ident(tbl), dq_ident(f), esc_sql(d)
      }
    }
  '
done >> "$out"
echo -e "${SUCCESS}success: Wrote $(wc -l < "$out") lines to $out${NC}"
}

check_requirements

echo -e "${INFO}info: processing database $g_input_file ...${NC}"
echo -e "${INFO}info: target database: $g_database, schema: $g_schema${NC}"
echo -e "${INFO}info: skip flags: $g_skip_schema, skip data: $g_skip_data${NC}"
echo -e "${INFO}info: data SQL file: $g_data_sql_file, schema SQL file: $g_schema_file${NC}"

if [ ! -f "${g_script_dir}/../.pgpass" ]; then
    echo -e "${WARNING}warning: no .pgpass file found at ${g_script_dir}/.pgpass; ensure PGPASSWORD is set or you will be prompted for password${NC}"
fi

if [ "$g_command" == "dump" ]; then
    if [ "$g_skip_schema" == "NO" ]; then
        if [ -f "$g_schema_file" ]; then
            usage "error: schema file $g_schema_file already exists (cannot overwrite)"
        fi
        dump_schema "$g_input_file" "$g_schema_file"
    fi
    if [ "$g_skip_comments" == "NO" ]; then
        extract_comments "$g_input_file" "resources/descriptions.sql"
    fi
    if [ "$g_skip_data" == "NO" ]; then
        dump_data "$g_input_file" "$g_data_sql_file"
        format_sql_file "$g_data_sql_file"
    fi
elif [ "$g_command" == "load" ]; then
    echo -e "${INFO}info: PostgreSQL host: $g_host, user: $g_user, port: $g_port${NC}"
    drop_data "$g_input_file"
    if [ "$g_skip_schema" == "NO" ]; then
        load_schema "$g_schema_file"
    fi
    if [ "$g_skip_comments" == "NO" ]; then
        execute_sql_file "resources/descriptions.sql"
    fi
    if [ "$g_skip_data" == "NO" ]; then
        load_data "$g_data_sql_file"
    fi
fi
