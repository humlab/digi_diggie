#!/bin/bash
# dumps a MS Access .mdb database into a PostgreSQL database
# requires mdbtools and psql client installed

SHELL=/bin/bash

set -e
# set -o pipefail
# IFS=$'\n\t'

if [ -f "$(dirname $0)/docker/.env" ]; then
    set -o allexport
    export $(grep -v 'PASSWORD' "$(dirname $0)/docker/.env" | xargs)
    set +o allexport
fi

KNOWN_TABLES=( "parishes" "communities" "sources" "land_use" "legal_sources" "winners" "seasons" "judgements" "community_names" "persons" "entries" )

g_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
g_database=${POSTGRES_DB:-digi_diggie}
g_schema=public
g_dump_schema=YES
g_dump_data=YES
g_load_data=NO
g_load_schema=NO
g_host=localhost
g_user=${POSTGRES_USER:-gudrun}
g_port=${POSTGRES_PORT:-5433}
g_timestamp=$(date +'%Y%m%d_%H%M%S')

g_input_file=
g_data_folder=${g_script_dir}/data

usage() {
    if [ "$1" != "" ]; then
        echo "error: $1" >&2
    fi
  cat <<EOF
Usage: $(basename "$0") [--database NAME] [--schema NAME] [--host HOST] [--user USER] [--port PORT] <input_file.mdb>

Options:
  --database,       -d   Target database name (default: \$POSTGRES_DB or required)
  --schema,         -s   Target schema name (default: ${g_schema})
  --no-dump-schema, -S   Dump schema (default: true)
  --no-dump-data,   -D   Dump data (default: true)
  --load-schema,    -L   Load dumped schema into database (default: false)
  --load-data,      -l   Load dumped data into database (default: false)
  --data-folder,    -D   Folder to load from / dump to (default: ${g_data_folder})
  --host,           -H   PostgreSQL host (default: ${g_host})
  --user,           -U   PostgreSQL user (default: ${g_user})
  --port,           -p   PostgreSQL port (default: 5433)
  --help                 Show this help

Auth:
  Use a .pgpass entry or export PGPASSWORD; script does NOT prompt.
EOF

    exit 64
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --data-folder|-d) g_data_folder=$2; shift 2 ;;
    --database|-d) g_database=$2; shift 2 ;;
    --schema|-s) g_schema=$2; shift 2 ;;
    --no-dump-schema|-S) g_dump_schema=NO; shift 1 ;;
    --no-dump-data|-D) g_dump_data=NO; shift 1 ;;
    --load-schema|-L) g_load_schema=YES; shift 1 ;;
    --load-data|-l) g_load_data=YES; shift 1 ;;
    --host|-H) g_host=$2; shift 2 ;;
    --user|-U) g_user=$2; shift 2 ;;
    --port|-p) g_port=$2; shift 2 ;;
    --help) usage; exit 0 ;;
    *) g_input_file=$1; shift ;;
  esac
done

g_output_data_file=${g_data_folder}/output/data.sql
g_output_schema_file=${g_data_folder}/output/schema.sql

echo "g_dump_schema: $g_dump_schema"
echo "g_dump_data: $g_dump_data"
echo "g_load_schema: $g_load_schema"
echo "g_load_data: $g_load_data"

function dump_schema() {

    local input_file=$1
    local output_file=$2

    mdb-schema --not-null --default-values \
        --namespace="${g_schema}" \
        --drop-table \
        --not-null \
        --default-values \
        --comments \
        --indexes \
        --relations \
        "$input_file" postgres > "$output_file"

    # grep -v 'REFERENCES' "$output_file" > "$output_file.tmp"
    # mv "$output_file.tmp" "$output_file"
    # sed -i 's/BOOLEAN NOT NULL DEFAULT FALSE/INTEGER NOT NULL DEFAULT 0/g' "$output_file"
    echo "info: schema dumped to $output_file"
}

function dump_data() {
    local input_file=$1
    local output_file=$2

    local tables=$(mdb-tables "$input_file")
    
    > "$output_file"
    for table in $tables; do
        if [[ ! " ${KNOWN_TABLES[*]} " =~ (^|[[:space:]])${table}([[:space:]]|$) ]]; then
            echo "warning: skipping unknown table $table"
        else
            mdb-export --insert=postgres "$input_file" "$table" >> "$output_file"
        fi
    done
    echo "info: data dumped to $output_file"

}

function execute_sql() {
    local sql=$1
    PGPASSFILE=${g_script_dir}/.pgpass -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -tac "$sql" >& /dev/null
}


function execute_sql_file() {
    local sql=$1
    PGPASSFILE=${g_script_dir}/.pgpass psql -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -f "$sql" >& /dev/null
}

function drop_data() {
    local input_file=$1
    for table in $(mdb-tables "$input_file"); do
        table="${table,,}"
        execute_sql "drop table if exists \"$table\" cascade;" >& /dev/null
    done
}

# function add_constraints() {
#     local input_file=$1
# }

function check_requirements() {
  for c in mdb-schema mdb-tables mdb-export psql; do
    command -v "$c" >/dev/null 2>&1 || { echo "error: missing $c" >&2; exit 1; }
  done
  for d in "$g_host" "$g_user" "$g_port" "$g_database"; do
    [ -n "$d" ] || { echo "error: missing database connection parameter" >&2; exit 1; }
  done
  [ "$g_input_file" != "" ] || { usage "error: input file not specified" >&2;  }
  [ -f "$g_input_file" ] || { usage "error: input file $g_input_file not found" >&2;  }
}

check_requirements
echo "info: dumping database from $g_input_file ..."

# add_constraints

mkdir -p "${g_data_folder}/output"

# drop_data "$g_input_file"

if [ "$g_dump_schema" == "YES" ]; then
    dump_schema "$g_input_file" "$g_output_schema_file"
fi
if [ "$g_dump_data" == "YES" ]; then
    dump_data "$g_input_file" "$g_output_data_file"
fi
if [ "$g_load_schema" == "YES" ]; then
    echo "info: loading schema from $g_output_schema_file ..."
    execute_sql_file "$g_output_schema_file"
fi
if [ "$g_load_data" == "YES" ]; then
    echo "info: loading data from $g_output_data_file ..."
    execute_sql_file "$g_output_data_file"
    execute_sql_file "$g_data_folder"/constraints.sql
    echo "info: data imported successfully into $g_database"
fi
