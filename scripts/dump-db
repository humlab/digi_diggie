#!/bin/bash

SHELL=/bin/bash

set -euo pipefail
IFS=$'\n\t'

if [ -f "$(dirname $0)/docker/.env" ]; then
    set -o allexport
    export $(grep -v 'PASSWORD' "$(dirname $0)/docker/.env" | xargs)
    set +o allexport
fi

g_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
g_database=${POSTGRES_DB}
# g_schema=
g_host=localhost
g_user=${POSTGRES_USER:-gudrun}
g_port=${POSTGRES_PORT:-5433}
g_timestamp=$(date +'%Y%m%d_%H%M%S')

g_input_file=
g_data_folder=${g_script_dir}/data
g_output_folder=${g_data_folder}/output

usage() {
    if [ "$1" != "" ]; then
        echo "error: $1" >&2
    fi
  cat <<EOF
Usage: $(basename "$0") [--database NAME] [--schema NAME] [--host HOST] [--user USER] [--port PORT] <input_file.mdb>

Options:
  --database, -d   Target database name (default: \$POSTGRES_DB or required)
  --schema,   -s   Target schema (created if missing; search_path set)
  --host,     -H   PostgreSQL host (default: ${g_host})
  --user,     -U   PostgreSQL user (default: ${g_user})
  --port,     -p   PostgreSQL port (default: 5433)
  --help           Show this help

Auth:
  Use a .pgpass entry or export PGPASSWORD; script does NOT prompt.
EOF
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --data-folder|-d) g_data_folder=$2; shift 2 ;;
    --output-folder|-o) g_output_folder=$2; shift 2 ;;
    --database|-d) g_database=$2; shift 2 ;;
    --schema|-s) g_schema=$2; g_schema="${g_schema,,}"; shift 2 ;;
    --host|-H) g_host=$2; shift 2 ;;
    --user|-U) g_user=$2; shift 2 ;;
    --port|-p) g_port=$2; shift 2 ;;
    --help) usage; exit 0 ;;
    *) g_input_file=$1; shift ;;
  esac
done

function dump_schema() {

    local input_file=$1
    local output_folder=$2
    local output_file="$output_folder"/schema.sql

    mdb-schema --not-null --default-values "$input_file" postgres > "$output_file"

    grep -v 'REFERENCES' "$output_file" > "$output_file.tmp"
    mv "$output_file.tmp" "$output_file"

    sed -i 's/BOOLEAN NOT NULL DEFAULT FALSE/INTEGER NOT NULL DEFAULT 0/g' "$output_file"
}

function dump_data() {
    local input_file=$1
    local output_folder=$2
    local output_file="$output_folder"/data.sql

    > "$output_file"
    for table in $(mdb-tables "$input_file"); do
        mdb-export --insert=postgres "$input_file" "$table" >> "$output_file"
    done
}

function execute_sql() {
    local sql=$1
    PGPASSFILE=${g_script_dir}/.pgpass -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -tac "$sql" >& /dev/null
}


function execute_sql_file() {
    local sql=$1
    PGPASSFILE=${g_script_dir}/.pgpass psql -p "$g_port" -h "$g_host" -d "$g_database" -U "$g_user" -v ON_ERROR_STOP=1 -f "$sql" >& /dev/null
}

function drop_data() {
    local input_file=$1
    for table in $(mdb-tables "$input_file"); do
        table="${table,,}"
        execute_sql "drop table if exists \"$table\" cascade;" >& /dev/null
    done
}

# function add_constraints() {
#     local input_file=$1
# }

function check_requirements() {
    if ! command -v mdb-schema &> /dev/null; then
        echo "Error: mdb-schema command not found. Please install mdb-tools." >&2
        exit 1
    fi

    if ! command -v mdb-tables &> /dev/null; then
        echo "Error: mdb-tables command not found. Please install mdb-tools." >&2
        exit 1
    fi

    if ! command -v mdb-export &> /dev/null; then
        echo "Error: mdb-export command not found. Please install mdb-tools." >&2
        exit 1
    fi

    if ! command -v psql &> /dev/null; then
        echo "Error: psql command not found. Please install PostgreSQL client tools." >&2
        exit 1
    fi
}
if [ -z "$g_input_file" ]; then
    usage "missing <input_file.mdb>"
    exit 1
fi

# add_constraints

check_requirements

mkdir -p "$g_output_folder"

drop_data "$g_input_file"

dump_schema "$g_input_file" "$g_output_folder"
dump_data "$g_input_file" "$g_output_folder"

execute_sql_file "$g_output_folder"/schema.sql
execute_sql_file "$g_output_folder"/data.sql
execute_sql_file "$g_data_folder"/constraints.sql

echo "Data imported successfully into $g_database"
echo "Schema and data dumped to $g_output_folder"